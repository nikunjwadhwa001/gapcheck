# Copy to .env for local development. Never commit the real .env.
PORT=8080

# Free key from https://aistudio.google.com (required)
GEMINI_API_KEY=

# Optional. Any Gemini model your key can use on the free tier.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Max time for one analysis (Go duration: 30s, 1m, ...).
LLM_TIMEOUT=30s

# Comma-separated origins allowed by CORS (used from Phase 3)
ALLOWED_ORIGINS=http://localhost:5000
