# Copy to .env for local development. Never commit the real .env.
PORT=8080

# Free key from https://aistudio.google.com (required)
GEMINI_API_KEY=

# Optional. Any Gemini model your key can use on the free tier.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Max time for one analysis (Go duration: 30s, 1m, ...).
LLM_TIMEOUT=30s

# Comma-separated browser origins allowed to call the API (CORS).
# localhost:3000 is the Flutter web dev server (flutter run -d chrome --web-port 3000).
# Not 5000: on macOS, AirPlay Receiver already uses that port.
ALLOWED_ORIGINS=http://localhost:3000
